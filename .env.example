# Copy to .env to override config/settings.yaml locally. Every key maps to WB_<SETTING>.
# The workbench needs no API keys: all models run on loopback inside the premises.

# heuristic (offline, deterministic) | scripted | openai (vLLM or any OpenAI-compatible server on loopback)
WB_LLM_BACKEND=heuristic

# Hardware profile used for routing and `workbench registry render-serve`: S | M | L
WB_PROFILE=S

# Host services: sandboxd / egressd (Go daemons) or fake (in-process stand-ins)
WB_SANDBOX=sandboxd
WB_EGRESS=egressd

# Router classifier endpoint when WB_LLM_BACKEND=openai (llama.cpp or vLLM on loopback)
WB_ROUTER_ENDPOINT=http://127.0.0.1:8010/v1

# Scales simulated wake times and tide waits (1.0 = real seconds)
WB_TIME_SCALE=0.05

# Optional: use a different repository root for config, templates and rules
# WB_ROOT=/srv/workbench
