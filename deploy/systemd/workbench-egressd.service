[Unit]
Description=Sovereign AI Workbench egress monitor (egressd)
Documentation=file:///srv/workbench/docs/DEPLOYMENT.md
After=nftables.service auditd.service
Wants=nftables.service

[Service]
Type=simple
User=wb-egress
Group=wb-egress
SupplementaryGroups=adm workbench
RuntimeDirectory=workbench
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
WorkingDirectory=/srv/workbench
ExecStart=/srv/workbench/bin/egressd -config /srv/workbench/config/go/egressd.json
Restart=on-failure
RestartSec=2
UMask=0007
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/workbench /srv/workspaces/_egress_probe
ReadOnlyPaths=/var/log/audit
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
