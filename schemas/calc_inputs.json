{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calculation inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "expression", "result_name", "result_unit", "variables"],
  "properties": {
    "title": {"type": "string"},
    "standard": {"type": "string"},
    "expression": {"type": "string", "minLength": 3},
    "result_name": {"type": "string"},
    "result_unit": {"type": "string"},
    "variables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "unit", "description", "record"],
        "properties": {
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "description": {"type": "string"},
          "record": {"type": "string"}
        }
      }
    }
  }
}
