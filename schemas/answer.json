{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cited answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer"],
  "properties": {
    "answer": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {"text": {"type": "string", "minLength": 1}}
      }
    },
    "not_found": {"type": "boolean"}
  }
}
